# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored — never commit real credentials.

# Where contact-form messages should land.
CONTACT_TO_EMAIL=souledouglas061@gmail.com

# Optional but preferred: Gmail SMTP.
# The Gmail address that will SEND the message (shows as the "From").
GMAIL_USER=souledouglas061@gmail.com

# A Gmail "App Password" — NOT your normal Gmail login password.
# Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account first).
# If left empty, messages are delivered via FormSubmit.co instead.
GMAIL_APP_PASSWORD=
